# Variáveis de Ambiente — Cardápio QR

# Copie este arquivo para .env.local e preencha com seus valores do Supabase

# URL do seu projeto Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave pública anon do Supabase (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# URL base da aplicação (use http://localhost:3000 em dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave secreta do Supabase (Settings > API > service_role secret)
# Necessária para o Webhook de pagamento atualizar assinaturas em segundo plano
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Mercado Pago — Credenciais para receber as mensalidades
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu_access_token_aqui

# E-mails com privilégios de Super Admin SaaS (separados por vírgula)
SUPERADMIN_EMAILS=seu_email_admin@exemplo.com

# Sentry — Observabilidade e Captura de Erros (Client & Server)
# Obtenha em: https://sentry.io -> Settings -> Projects -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://exemplo@o0.ingest.sentry.io/0
SENTRY_DSN=https://exemplo@o0.ingest.sentry.io/0


