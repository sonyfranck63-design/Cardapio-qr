# Variáveis de Ambiente — Cardápio QR

# Copie este arquivo para .env.local e preencha com seus valores do Supabase

# URL do seu projeto Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave pública anon do Supabase (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# URL base da aplicação (use http://localhost:3000 em dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
